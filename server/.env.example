# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Client URL (for CORS)
CLIENT_URL=http://localhost

# LLM Configuration (LMStudio, OpenAI, or compatible)
LLM_BASE_URL=http://192.168.0.107:1234/v1
LLM_MODEL=openai/gpt-oss-20b


# File Upload
MAX_FILE_SIZE=10485760

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/tax-gpt
MONGODB_DB_NAME=tax-gpt

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
