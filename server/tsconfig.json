{
  "compilerOptions": {
    // Target & Module - Match Node 22 and esbuild ESM output
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],

    // Emit - esbuild handles transpilation, tsc is only for type checking
    "noEmit": true,
    "sourceMap": false,

    // Type Checking
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Decorators for TSyringe
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    // Interop
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // Paths - IDE/editor support for aliases
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@config/*": ["./config/*"],
      "@api/*": ["./api/*"],
      "@core/*": ["./core/*"],
      "@infrastructure/*": ["./infrastructure/*"],
      "@agent/*": ["./agent/*"],
      "@models/*": ["./models/*"],
      "@services/*": ["./services/*"],
      "@utils/*": ["./utils/*"],
      "@shared/*": ["./shared/*"],
      "@domains/*": ["./domains/*"]
    },

    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", ".mastra"]
}
