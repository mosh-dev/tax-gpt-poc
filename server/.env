# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Client URL (for CORS)
CLIENT_URL=http://localhost:4200

# LLM Configuration (LMStudio, OpenAI, or compatible)
LLM_BASE_URL=http://192.168.0.107:1234/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=your-api-key-here

# File Upload
MAX_FILE_SIZE=10485760

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/tax-gpt
MONGODB_DB_NAME=tax-gpt

# MongoDB Atlas Configuration (Required for Vector Storage)
# Replace with your MongoDB Atlas connection string for vector operations
# MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
