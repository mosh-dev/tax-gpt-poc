# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Client URL (for CORS)
CLIENT_URL=http://localhost

# LLM Configuration (LMStudio, OpenAI, or compatible)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=openai/gpt-oss-20b
; LLM_MODEL=qwen/qwen3-30b-a3b-2507

; LLM_BASE_URL=https://api.openai.com/v1
; LLM_MODEL=gpt-4o

FORCE_SEED_SYSTEM_INSTRUCTION=true


# File Upload
MAX_FILE_SIZE=10485760

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/tax-gpt
MONGODB_DB_NAME=tax-gpt

# JWT Configuration
JWT_SECRET=tax-gpt-jwt-secret-dev-only-change-in-production
JWT_REFRESH_SECRET=tax-gpt-jwt-refresh-secret-dev-only-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
