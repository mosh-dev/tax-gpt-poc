{
  "name": "tax-gpt-server",
  "version": "1.0.0",
  "description": "Backend server for Tax-GPT application",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/assets/**/*\" dist",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.25",
    "@mastra/core": "^1.0.0-beta.2",
    "@mastra/fastembed": "^1.0.0-beta.0",
    "@mastra/libsql": "^1.0.0-beta.0",
    "@mastra/memory": "^1.0.0-beta.0",
    "@mastra/mongodb": "^1.0.0-beta.0",
    "canvas": "~3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "gpt-tokenizer": "^3.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.4",
    "multer": "^2.0.2",
    "pdf-parse": "~2.4.5",
    "pdfkit": "~0.17.2",
    "safe-stable-stringify": "^2.5.0",
    "sharp": "~0.34.5",
    "tesseract.js": "~6.0.1"
  },
  "private": true,
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
