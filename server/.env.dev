# Server Configuration
NODE_ENV=development

PORT=3000
SERVER_PORT=3000
BASE_URL=https://taxgpt-api.inb.seliselocal.com

# Client URL (for CORS)
CLIENT_URL=https://taxgpt.inb.seliselocal.com/

# LLM Configuration (LMStudio, OpenAI, or compatible)
# Primary model (used as fallback for all unspecified models)
LLM_MODEL=gpt-5
LLM_BASE_URL=https://api.openai.com/v1

# Optional: Specialized models (if not set, primary model is used)
# Extraction model (recommended: GPT-4o for structured data extraction)
LLM_EXTRACTION_MODEL=gpt-4o
LLM_EXTRACTION_BASE_URL=https://api.openai.com/v1

# Secondary model (for secondary tasks)
# LLM_SECONDARY_MODEL=gpt-4o
# LLM_SECONDARY_BASE_URL=https://api.openai.com/v1

# Simple chat model (for simple conversations)
# LLM_SIMPLE_CHAT_MODEL=gpt-3.5-turbo
# LLM_SIMPLE_CHAT_BASE_URL=https://api.openai.com/v1

FORCE_SEED_SYSTEM_INSTRUCTION=false


# File Upload
MAX_FILE_SIZE=10485760

# MongoDB Configuration
MONGODB_URI=mongodb://172.16.2.170:27017/tax-gpt
MONGODB_DB_NAME=tax-gpt

# JWT Configuration
JWT_SECRET=tax-gpt-jwt-secret-dev-only-change-in-production
JWT_REFRESH_SECRET=tax-gpt-jwt-refresh-secret-dev-only-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

