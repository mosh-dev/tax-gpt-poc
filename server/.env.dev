# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=https://taxgpt-api.inb.seliselocal.com

# Client URL (for CORS)
CLIENT_URL=http://localhost:4200

# LLM Configuration (LMStudio, OpenAI, or compatible)
LLM_BASE_URL=http://192.168.227.117:1234/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=your-api-key-here

# File Upload
MAX_FILE_SIZE=10485760

# MongoDB Configuration
MONGODB_URI=mongodb://172.16.2.170:27017/tax-gpt
MONGODB_DB_NAME=tax-gpt

# JWT Configuration
JWT_SECRET=tax-gpt-jwt-secret-dev-only-change-in-production
JWT_REFRESH_SECRET=tax-gpt-jwt-refresh-secret-dev-only-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

