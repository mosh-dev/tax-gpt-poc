# Development/Cloud Environment Configuration
# Use with: docker-compose --env-file .env.dev up

# Server Configuration
NODE_ENV=development
BASE_URL=http://localhost:3000

# Client URL (for CORS)
CLIENT_URL=http://localhost:80

# LLM Configuration (OpenAI or compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4
LLM_API_KEY=your-openai-api-key

# MongoDB Configuration (Remote MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tax-gpt?retryWrites=true&w=majority
MONGODB_DB_NAME=tax-gpt

# File Upload
MAX_FILE_SIZE=10485760
